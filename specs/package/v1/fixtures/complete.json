    "agent.yaml": "{\"format\":\"woobe-package\",\"schema_version\":\"1.0\",\"kind\":\"Agent\",\"metadata\":{\"key\":\"support\",\"name\":\"Support\"},\"spec\":{\"model\":{\"primary\":{\"ref\":\"primary\"},\"fallback\":{\"ref\":\"fallback\"},\"parameters\":{\"temperature\":0.23,\"max_output_tokens\":1234}},\"tools\":[{\"ref\":\"lookup\"},{\"ref\":\"guarded\"}],\"external_context\":{\"tenant\":{\"schema\":{\"type\":\"string\"},\"default\":\"portable-tenant\"}},\"knowledge\":{\"source\":{\"ref\":\"knowledge\"},\"rag\":{\"top_k\":3,\"candidate_k\":7,\"max_context_chunks\":3,\"max_chunks_per_document\":2,\"max_context_chars\":11000}},\"context\":{\"policy\":{\"allowed_sources\":[\"SYSTEM\",\"USER_INPUT\",\"SESSION\",\"TOOL\",\"SKILL\",\"KNOWLEDGE\",\"RUNTIME\"],\"skills\":{}},\"manager\":{\"name\":\"stdcm\"}},\"skills\":[{\"ref\":\"support-skill\",\"version\":\"1.0.0\"}],\"prompt_ref\":\"instructions\",\"execution\":{\"strategy\":\"standard\",\"config\":{}},\"session\":{\"mode\":\"stateful\"},\"output\":{\"contract_ref\":\"answer\"}}}\n",
    "woobe.yaml": "{\"format\":\"woobe-package\",\"schema_version\":\"1.0\",\"kind\":\"Package\",\"metadata\":{\"name\":\"Support\",\"version\":\"1.0.0\"},\"spec\":{\"entrypoint\":{\"kind\":\"Network\",\"ref\":\"support-network\"},\"resources\":[\"agent.yaml\",\"model.yaml\",\"mcp.yaml\",\"embedding.yaml\",\"knowledge.yaml\",\"skill.yaml\",\"fallback.yaml\",\"contract.yaml\",\"prompt.yaml\",\"specialist.yaml\",\"network.yaml\",\"http.yaml\"],\"requires\":{\"credentials\":[{\"ref\":\"primary\",\"provider\":\"custom\"}],\"project_environment\":[{\"key\":\"PACKAGE_TEST_TOKEN\",\"kind\":\"secret\"}],\"secrets\":[{\"ref\":\"package-tool-token\"}]}}}\n",
