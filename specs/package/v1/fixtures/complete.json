    "prompt.yaml": "{\"format\":\"woobe-package\",\"schema_version\":\"1.0\",\"kind\":\"Prompt\",\"metadata\":{\"key\":\"instructions\",\"name\":\"Instructions\"},\"spec\":{\"version\":\"1.0.0\",\"content\":\"Resolve portable customer requests with the installed capabilities.\"}}\n",
