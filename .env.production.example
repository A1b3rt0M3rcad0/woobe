# Copy to .env.production in the deployment host or inject equivalent secrets.
# Never commit .env.production.
POSTGRES_USER=projectrai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=projectrai

RABBITMQ_DEFAULT_USER=projectrai
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_DEFAULT_VHOST=/
DB_USER=projectrai
DB_PASSWORD=change-me

PROJECTRAI_DATABASE_URL=postgresql+asyncpg://projectrai:change-me@pgbouncer:6432/projectrai
PROJECTRAI_RABBITMQ_URL=amqp://projectrai:change-me@rabbitmq:5672/
PROJECTRAI_RABBITMQ_EXCHANGE=projectrai.events
PROJECTRAI_SECRET_KEY=replace-with-at-least-32-random-characters
PROJECTRAI_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
PROJECTRAI_CORS_ORIGINS=https://app.example.com
PROJECTRAI_TRUSTED_HOSTS=app.example.com
PROJECTRAI_LOG_LEVEL=INFO
PROJECTRAI_REQUEST_MAX_BYTES=1048576
