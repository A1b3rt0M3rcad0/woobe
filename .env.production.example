# Production backend/infrastructure configuration.
# Usage:
#   cp .env.production.example .env
#   cp .env.web.production.example .env.web
#   fill the REQUIRED secret/domain values below
#   docker compose -f docker-compose.prod.yml up --build -d
#
# Never commit the resulting .env or .env.web. Production intentionally does not
# ship with public credentials or encryption keys.

PROJECTRAI_ENVIRONMENT=production
PROJECTRAI_DEBUG=false
PROJECTRAI_JSON_LOGS=true
PROJECTRAI_METRICS_ENABLED=true
PROJECTRAI_LOG_LEVEL=INFO
PROJECTRAI_REQUEST_MAX_BYTES=1048576

# Docker Compose derives database/RabbitMQ URLs from the credential sources below
# and fixes Redis to redis://redis:6379/0. External deployments must provide their
# own PROJECTRAI_DATABASE_URL / PROJECTRAI_RABBITMQ_URL / PROJECTRAI_REDIS_URL.
PROJECTRAI_RABBITMQ_EXCHANGE=projectrai.events

# REQUIRED: independent URL-safe random secrets, at least 32 characters each.
PROJECTRAI_SECRET_KEY=
PROJECTRAI_ENCRYPTION_KEY=

PROJECTRAI_AUTH_ISSUER=projectrai
PROJECTRAI_AUTH_AUDIENCE=projectrai-web
PROJECTRAI_ACCESS_TOKEN_TTL_SECONDS=900
PROJECTRAI_REFRESH_TOKEN_TTL_DAYS=30
PROJECTRAI_AUTH_CLOCK_SKEW_SECONDS=30
PROJECTRAI_ACCESS_COOKIE_NAME=projectrai_access
PROJECTRAI_ACCESS_COOKIE_SECURE=true
PROJECTRAI_ACCESS_COOKIE_SAME_SITE=lax
PROJECTRAI_REFRESH_COOKIE_NAME=projectrai_refresh
PROJECTRAI_REFRESH_COOKIE_SECURE=true
PROJECTRAI_REFRESH_COOKIE_SAME_SITE=lax
PROJECTRAI_CSRF_COOKIE_NAME=projectrai_csrf
PROJECTRAI_CSRF_HEADER_NAME=x-csrf-token

PROJECTRAI_DB_POOL_SIZE=5
PROJECTRAI_DB_MAX_OVERFLOW=5

# REQUIRED: exact public Production origins/hosts.
PROJECTRAI_CORS_ORIGINS=
PROJECTRAI_TRUSTED_HOSTS=

PROJECTRAI_HOST=0.0.0.0
PROJECTRAI_PORT=8000
PROJECTRAI_WEB_PORT=8080
PROJECTRAI_WORKER_INTERVAL=5.0

# Local storage is backed by the shared uploads_data Docker volume in this single-host
# Production topology. Switch to s3 for multi-host/ephemeral deployments.
PROJECTRAI_STORAGE_DRIVER=local
PROJECTRAI_UPLOAD_MAX_MB=25
PROJECTRAI_UPLOAD_ALLOWED_EXTENSIONS=.txt,.md,.pdf,.docx
PROJECTRAI_UPLOAD_LOCAL_DIR=./storage/uploads
PROJECTRAI_RAG_DOCX_MAX_UNCOMPRESSED_MB=100
PROJECTRAI_RAG_DOCX_MAX_ENTRIES=1000
PROJECTRAI_RAG_DOCX_MAX_COMPRESSION_RATIO=100
PROJECTRAI_S3_BUCKET=
PROJECTRAI_S3_REGION=us-east-1
PROJECTRAI_S3_PREFIX=uploads
PROJECTRAI_S3_ENDPOINT_URL=
PROJECTRAI_S3_FORCE_PATH_STYLE=false
PROJECTRAI_S3_SERVER_SIDE_ENCRYPTION=AES256
PROJECTRAI_MCP_SESSION_CACHE_ENABLED=true
PROJECTRAI_MCP_SESSION_TTL_SECONDS=3600

# REQUIRED: single source of truth for Docker-managed PostgreSQL.
# Prefer URL-safe generated passwords (for example Python secrets.token_urlsafe).
# If a manually chosen value contains '$', single-quote the whole .env value.
POSTGRES_USER=projectrai
POSTGRES_PASSWORD=
POSTGRES_DB=projectrai

# REQUIRED: single source of truth for Docker-managed RabbitMQ.
RABBITMQ_USER=projectrai
RABBITMQ_PASSWORD=

# PgBouncer capacity policy. Override only when deployment capacity requires it.
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_RESERVE_POOL_SIZE=5
PGBOUNCER_MAX_DB_CONNECTIONS=30
