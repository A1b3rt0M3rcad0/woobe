# ProjectRAI Environment Configuration
# Copy this file to .env and fill in your values.

# Database (via PgBouncer)
PROJECTRAI_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:6432/projectrai

# Application
PROJECTRAI_DEBUG=true
PROJECTRAI_ENVIRONMENT=development
PROJECTRAI_LOG_LEVEL=INFO
PROJECTRAI_HOST=0.0.0.0
PROJECTRAI_PORT=8000

# Security (REQUIRED - set strong values in production)
PROJECTRAI_SECRET_KEY=change-this-to-a-strong-random-key
PROJECTRAI_ENCRYPTION_KEY=change-this-to-a-strong-32-char-key

# Database Connection Pool
PROJECTRAI_DB_POOL_SIZE=20
PROJECTRAI_DB_MAX_OVERFLOW=10

# CORS (comma-separated origins)
PROJECTRAI_CORS_ORIGINS=*

# Workers
PROJECTRAI_WORKER_INTERVAL=5.0

# RabbitMQ
PROJECTRAI_RABBITMQ_URL=amqp://projectrai:projectrai@localhost:5672/
PROJECTRAI_RABBITMQ_EXCHANGE=projectrai.events

# PostgreSQL (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=projectrai

# RabbitMQ (used by docker-compose)
RABBITMQ_USER=projectrai
RABBITMQ_PASSWORD=projectrai
