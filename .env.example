# ProjectRAI / Woobe deployment manifest.
#
# This is the single configuration contract for development, staging and production.
# Copy it to .env and change values/endpoints for the deployment:
#
#   cp .env.example .env
#
# Connections between services are expressed as URLs. The bundled infrastructure
# bootstrap variables exist only so docker-compose.yml can provision a complete
# local/single-node stack. API, Workers and Migration do not consume those bootstrap
# credentials directly.
#
# A distributed deployment may extract only the variables required by each service.

# ============================================================
# DEPLOYMENT / APPLICATION-WIDE
# Consumed by: API, WORKERS
# ============================================================

PROJECTRAI_ENVIRONMENT=development
PROJECTRAI_DEBUG=false
PROJECTRAI_JSON_LOGS=true
PROJECTRAI_METRICS_ENABLED=true
PROJECTRAI_LOG_LEVEL=INFO

# API signing key. Required only by API.
PROJECTRAI_SECRET_KEY=local-projectrai-signing-key-4v7N2x9Q8m5K1c6Z

# ChatSurface browser tokens use a separate trust boundary.
PROJECTRAI_CHAT_SURFACE_ENABLED=true
PROJECTRAI_CHAT_TOKEN_SIGNING_KEY=local-chat-surface-signing-key-8K2v5N7m4Q1x9C6Z
PROJECTRAI_CHAT_TOKEN_ISSUER=projectrai-chat
PROJECTRAI_CHAT_TOKEN_AUDIENCE=projectrai-chat-embed
PROJECTRAI_CHAT_TOKEN_TTL_SECONDS=900
PROJECTRAI_CHAT_SURFACE_SESSION_CREATE_RATE_LIMIT=30
PROJECTRAI_CHAT_SURFACE_TOKEN_ISSUE_RATE_LIMIT=120

# Encryption key for persisted application secrets. Required by API/Workers.
PROJECTRAI_ENCRYPTION_KEY=local-projectrai-encryption-key-7Q2m9K4x1V8c5Z6N

# ============================================================
# POSTGRESQL — DIRECT DATABASE
#
# Connection URL consumed by:
#   - MIGRATION (direct schema changes)
#   - PGBOUNCER (upstream database)
#
# API and WORKERS must NOT use this URL directly.
# Replace host/credentials when PostgreSQL runs elsewhere.
# ============================================================

PROJECTRAI_POSTGRES_URL=postgresql://projectrai:projectrai@db:5432/projectrai

# Bundled PostgreSQL bootstrap only (docker-compose.yml service "db").
# Keep these aligned with PROJECTRAI_POSTGRES_URL only when using the bundled DB.
POSTGRES_USER=projectrai
POSTGRES_PASSWORD=projectrai
POSTGRES_DB=projectrai

# ============================================================
# PGBOUNCER — RUNTIME DATABASE ENDPOINT
#
# PROJECTRAI_DATABASE_URL is consumed by:
#   - API
#   - WORKERS
#
# PgBouncer connects upstream through PROJECTRAI_POSTGRES_URL above.
# In distributed deployments this URL can point to any compatible pool/proxy.
# ============================================================

PROJECTRAI_DATABASE_URL=postgresql://projectrai:projectrai@pgbouncer:6432/projectrai
PROJECTRAI_DB_POOL_SIZE=5
PROJECTRAI_DB_MAX_OVERFLOW=5

# Bundled PgBouncer capacity policy only.
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_RESERVE_POOL_SIZE=5
PGBOUNCER_MAX_DB_CONNECTIONS=30

# ============================================================
# RABBITMQ
#
# Connection URL consumed by:
#   - WORKERS
#
# API does not require RabbitMQ to start.
# ============================================================

PROJECTRAI_RABBITMQ_URL=amqp://projectrai:projectrai@rabbitmq:5672/
PROJECTRAI_RABBITMQ_EXCHANGE=projectrai.events

# Bundled RabbitMQ bootstrap only (docker-compose.yml service "rabbitmq").
# Keep these aligned with PROJECTRAI_RABBITMQ_URL only when using the bundled broker.
RABBITMQ_USER=projectrai
RABBITMQ_PASSWORD=projectrai

# ============================================================
# REDIS
#
# Connection URL consumed by:
#   - API / WORKERS when Redis-backed features are enabled
# ============================================================

PROJECTRAI_REDIS_URL=redis://redis:6379/0
PROJECTRAI_REDIS_CONNECT_TIMEOUT_SECONDS=2.0
PROJECTRAI_MCP_SESSION_CACHE_ENABLED=true
PROJECTRAI_MCP_SESSION_KEY_PREFIX=projectrai:mcp-session
PROJECTRAI_MCP_SESSION_TTL_SECONDS=3600

# ============================================================
# OBJECT STORAGE — S3 COMPATIBLE
#
# Consumed by:
#   - API
#   - WORKERS
#
# Development uses bundled MinIO so the storage semantics match distributed
# production. For AWS S3 leave PROJECTRAI_S3_ENDPOINT_URL empty and normally use
# IAM/workload credentials instead of static AWS_* values.
# ============================================================

PROJECTRAI_STORAGE_DRIVER=s3
PROJECTRAI_UPLOAD_MAX_MB=25
PROJECTRAI_UPLOAD_ALLOWED_EXTENSIONS=.txt,.md,.pdf,.docx
PROJECTRAI_UPLOAD_LOCAL_DIR=./storage/uploads
PROJECTRAI_S3_BUCKET=woobe-local
PROJECTRAI_S3_REGION=us-east-1
PROJECTRAI_S3_PREFIX=uploads
PROJECTRAI_S3_ENDPOINT_URL=http://minio:9000
PROJECTRAI_S3_FORCE_PATH_STYLE=true
PROJECTRAI_S3_SERVER_SIDE_ENCRYPTION=

# Local MinIO/client credentials. In managed environments prefer workload/IAM auth.
AWS_ACCESS_KEY_ID=projectrai
AWS_SECRET_ACCESS_KEY=local-projectrai-object-storage-key-7Q2m9K4x

PROJECTRAI_RAG_DOCX_MAX_UNCOMPRESSED_MB=100
PROJECTRAI_RAG_DOCX_MAX_ENTRIES=1000
PROJECTRAI_RAG_DOCX_MAX_COMPRESSION_RATIO=100

# ============================================================
# RUNTIME / NETWORK POLICY
# Consumed by: API, WORKERS
# Keep these equal across replicas handling the same Project runtime.
# ============================================================

PROJECTRAI_RUNTIME_MAX_CONCURRENCY_PER_KEY=4
PROJECTRAI_RUNTIME_MAX_PROMPT_CHARS=32768
PROJECTRAI_RUNTIME_MAX_METADATA_BYTES=16384
PROJECTRAI_RUNTIME_MAX_SNAPSHOT_OVERRIDE_BYTES=32768
PROJECTRAI_RUNTIME_MAX_REQUEST_BYTES=262144
PROJECTRAI_RUNTIME_TOTAL_TIMEOUT_SECONDS=120
PROJECTRAI_NETWORK_RUNTIME_ENABLED=true
PROJECTRAI_NETWORK_STREAM_HEARTBEAT_SECONDS=10
PROJECTRAI_NETWORK_MAX_DEPTH_DEFAULT=4
PROJECTRAI_NETWORK_MAX_DEPTH_HARD=8
PROJECTRAI_NETWORK_MAX_INVOCATIONS_DEFAULT=16
PROJECTRAI_NETWORK_MAX_INVOCATIONS_HARD=64
PROJECTRAI_NETWORK_TIMEOUT_DEFAULT_SECONDS=90
PROJECTRAI_NETWORK_TIMEOUT_HARD_SECONDS=300
PROJECTRAI_NETWORK_EXECUTION_LEASE_TTL_SECONDS=30
PROJECTRAI_NETWORK_EXECUTION_LEASE_HEARTBEAT_SECONDS=10
PROJECTRAI_HTTP_TOOL_TIMEOUT_MAX_MS=30000
PROJECTRAI_HTTP_TOOL_RESPONSE_MAX_BYTES=1048576

# ============================================================
# API
#
# Required connections:
#   PROJECTRAI_DATABASE_URL
#   PROJECTRAI_REDIS_URL (when enabled)
#   OBJECT STORAGE settings above
#
# The API bootstrap fixes its own runtime role; no service-role env is required.
# ============================================================

PROJECTRAI_AUTH_ISSUER=projectrai
PROJECTRAI_AUTH_AUDIENCE=projectrai-web
PROJECTRAI_ACCESS_TOKEN_TTL_SECONDS=900
PROJECTRAI_REFRESH_TOKEN_TTL_DAYS=30
PROJECTRAI_AUTH_CLOCK_SKEW_SECONDS=30
PROJECTRAI_ACCESS_COOKIE_NAME=projectrai_access
PROJECTRAI_ACCESS_COOKIE_SECURE=false
PROJECTRAI_ACCESS_COOKIE_SAME_SITE=lax
PROJECTRAI_REFRESH_COOKIE_NAME=projectrai_refresh
PROJECTRAI_REFRESH_COOKIE_SECURE=false
PROJECTRAI_REFRESH_COOKIE_SAME_SITE=lax
PROJECTRAI_CSRF_COOKIE_NAME=projectrai_csrf
PROJECTRAI_CSRF_HEADER_NAME=x-csrf-token
PROJECTRAI_LOGIN_RATE_LIMIT_ATTEMPTS=10
PROJECTRAI_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
PROJECTRAI_API_KEY_RATE_LIMIT_REQUESTS=120
PROJECTRAI_API_KEY_RATE_LIMIT_WINDOW_SECONDS=60
PROJECTRAI_REQUEST_MAX_BYTES=1048576
PROJECTRAI_READINESS_TIMEOUT_SECONDS=3.0
PROJECTRAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
PROJECTRAI_TRUSTED_HOSTS=localhost,127.0.0.1
PROJECTRAI_HOST=0.0.0.0
PROJECTRAI_PORT=8000

# ============================================================
# WORKERS
#
# Required connections:
#   PROJECTRAI_DATABASE_URL
#   PROJECTRAI_RABBITMQ_URL
#   PROJECTRAI_REDIS_URL (when enabled)
#   OBJECT STORAGE settings above
#
# Worker bootstrap fixes its own runtime role; no service-role env is required.
# ============================================================

PROJECTRAI_WORKER_INTERVAL=5.0
PROJECTRAI_WORKER_HEALTH_FILE=/tmp/projectrai/worker-health.json
PROJECTRAI_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
PROJECTRAI_WORKER_HEALTH_MAX_AGE_SECONDS=45
PROJECTRAI_NETWORK_WORKER_PREFETCH=4
PROJECTRAI_NETWORK_WORKER_SLOTS=4
PROJECTRAI_OUTBOX_BATCH_SIZE=50
PROJECTRAI_INBOX_BATCH_SIZE=50
PROJECTRAI_OUTBOX_LOCK_TIMEOUT_SECONDS=300
PROJECTRAI_INBOX_LOCK_TIMEOUT_SECONDS=300
PROJECTRAI_OUTBOX_MAX_RETRIES=3
PROJECTRAI_RETRY_BASE_DELAY_SECONDS=1.0
PROJECTRAI_RETRY_MAX_DELAY_SECONDS=300.0
PROJECTRAI_RETRY_BACKOFF_MULTIPLIER=2.0

# ============================================================
# WEB
#
# Public build-time URLs used by the browser. These values are public by design;
# no backend secret is passed to the web build.
# ============================================================

VITE_API_URL=http://localhost:8000
VITE_CHAT_EMBED_URL=http://localhost:8081
PROJECTRAI_WEB_PORT=5173

# ============================================================
# CHATSURFACE EMBED
#
# The static loader is available at:
#   http://localhost:${PROJECTRAI_CHAT_EMBED_PORT}/chat/v1/embed.js
# The runtime iframe and Control Plane preview are served from the same origin.
# ============================================================

PROJECTRAI_CHAT_EMBED_PORT=8081
