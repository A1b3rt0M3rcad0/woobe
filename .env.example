# Woobe Core configuration template.
# For a first self-host install, generate a .env with independent random secrets:
#   python scripts/generate_self_host_env.py

# ============================================================
# APPLICATION
# ============================================================
WOOBE_EDITION=core
WOOBE_ENVIRONMENT=development
WOOBE_DEBUG=false
WOOBE_JSON_LOGS=true
WOOBE_METRICS_ENABLED=true
WOOBE_LOG_LEVEL=INFO

WOOBE_SECRET_KEY=local-woobe-signing-key-4v7N2x9Q8m5K1c6Z
WOOBE_ENCRYPTION_KEY=local-woobe-encryption-key-7Q2m9K4x1V8c5Z6N

WOOBE_CHAT_SURFACE_ENABLED=true
# false: ChatSurface host origins must use HTTPS outside local/dev environments.
# true: explicitly allows exact HTTP host origins, including private LAN addresses.
# Keep disabled for Internet-facing deployments unless insecure transport is intentional.
WOOBE_CHAT_SURFACE_ALLOW_INSECURE_ORIGINS=false
WOOBE_CHAT_TOKEN_SIGNING_KEY=local-woobe-chat-signing-key-8K2v5N7m4Q1x9C6Z
WOOBE_CHAT_TOKEN_ISSUER=woobe-chat
WOOBE_CHAT_TOKEN_AUDIENCE=woobe-chat-embed
WOOBE_CHAT_TOKEN_TTL_SECONDS=900
WOOBE_CHAT_SURFACE_SESSION_CREATE_RATE_LIMIT=30
WOOBE_CHAT_SURFACE_TOKEN_ISSUE_RATE_LIMIT=120

# ============================================================
# POSTGRESQL
# ============================================================
WOOBE_POSTGRES_URL=postgresql://woobe:woobe@db:5432/woobe
WOOBE_DATABASE_URL=postgresql://woobe:woobe@db:5432/woobe
WOOBE_DB_POOL_SIZE=10
WOOBE_DB_MAX_OVERFLOW=10
POSTGRES_USER=woobe
POSTGRES_PASSWORD=woobe
POSTGRES_DB=woobe

# Optional contributor topology (deploy/dev/compose.yml).
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_RESERVE_POOL_SIZE=5
PGBOUNCER_MAX_DB_CONNECTIONS=30

# ============================================================
# RABBITMQ
# ============================================================
WOOBE_RABBITMQ_URL=amqp://woobe:woobe@rabbitmq:5672/
WOOBE_RABBITMQ_EXCHANGE=woobe.events
RABBITMQ_USER=woobe
RABBITMQ_PASSWORD=woobe

# ============================================================
# REDIS / MCP SESSION CACHE
# Redis is part of the supported Core runtime topology.
# ============================================================
WOOBE_REDIS_URL=
WOOBE_REDIS_CONNECT_TIMEOUT_SECONDS=2.0
WOOBE_MCP_SESSION_CACHE_ENABLED=false
WOOBE_MCP_SESSION_KEY_PREFIX=woobe:mcp-session
WOOBE_MCP_SESSION_TTL_SECONDS=3600

# ============================================================
# STORAGE / KNOWLEDGE
# Local persistent storage is the Core default.
# ============================================================
WOOBE_STORAGE_DRIVER=local
WOOBE_UPLOAD_MAX_MB=25
WOOBE_UPLOAD_ALLOWED_EXTENSIONS=.txt,.md,.pdf,.docx
WOOBE_UPLOAD_LOCAL_DIR=/app/storage/uploads

# Optional S3-compatible settings used by explicit distributed/dev topologies.
WOOBE_S3_BUCKET=woobe-local
WOOBE_S3_REGION=us-east-1
WOOBE_S3_PREFIX=uploads
WOOBE_S3_ENDPOINT_URL=
WOOBE_S3_FORCE_PATH_STYLE=false
WOOBE_S3_SERVER_SIDE_ENCRYPTION=
AWS_ACCESS_KEY_ID=woobe
AWS_SECRET_ACCESS_KEY=local-woobe-object-storage-key-7Q2m9K4x

WOOBE_RAG_DOCX_MAX_UNCOMPRESSED_MB=100
WOOBE_RAG_DOCX_MAX_ENTRIES=1000
WOOBE_RAG_DOCX_MAX_COMPRESSION_RATIO=100

# ============================================================
# RUNTIME / NETWORK
# ============================================================
WOOBE_RUNTIME_MAX_CONCURRENCY_PER_KEY=4
WOOBE_RUNTIME_MAX_PROMPT_CHARS=32768
WOOBE_RUNTIME_MAX_METADATA_BYTES=16384
WOOBE_RUNTIME_MAX_SNAPSHOT_OVERRIDE_BYTES=32768
WOOBE_RUNTIME_MAX_REQUEST_BYTES=262144
WOOBE_RUNTIME_TOTAL_TIMEOUT_SECONDS=120
# Concrete registered Context Manager strategy used for newly created Agents.
# Existing Agent/Release snapshots keep their frozen selection and strategy identity.
WOOBE_DEFAULT_CONTEXT_MANAGER=stdcm:v1
WOOBE_NETWORK_RUNTIME_ENABLED=true
WOOBE_NETWORK_STREAM_HEARTBEAT_SECONDS=10
WOOBE_NETWORK_MAX_DEPTH_DEFAULT=4
WOOBE_NETWORK_MAX_DEPTH_HARD=8
WOOBE_NETWORK_MAX_INVOCATIONS_DEFAULT=16
WOOBE_NETWORK_MAX_INVOCATIONS_HARD=64
WOOBE_NETWORK_TIMEOUT_DEFAULT_SECONDS=90
WOOBE_NETWORK_TIMEOUT_HARD_SECONDS=300
WOOBE_NETWORK_EXECUTION_LEASE_TTL_SECONDS=30
WOOBE_NETWORK_EXECUTION_LEASE_HEARTBEAT_SECONDS=10
WOOBE_HTTP_TOOL_TIMEOUT_MAX_MS=30000
WOOBE_HTTP_TOOL_RESPONSE_MAX_BYTES=1048576
# false: HTTP Tools may target only public addresses.
# true: also allows localhost/loopback and private LAN addresses.
# Link-local/metadata, multicast, reserved and unspecified addresses stay blocked.
WOOBE_HTTP_TOOL_ALLOW_LOCAL_NETWORKS=false

# ============================================================
# API / AUTH
# ============================================================
WOOBE_AUTH_ISSUER=woobe
WOOBE_AUTH_AUDIENCE=woobe-web
WOOBE_ACCESS_TOKEN_TTL_SECONDS=900
WOOBE_REFRESH_TOKEN_TTL_DAYS=30
WOOBE_AUTH_CLOCK_SKEW_SECONDS=30
WOOBE_ACCESS_COOKIE_NAME=woobe_access
WOOBE_ACCESS_COOKIE_SECURE=false
WOOBE_ACCESS_COOKIE_SAME_SITE=lax
WOOBE_REFRESH_COOKIE_NAME=woobe_refresh
WOOBE_REFRESH_COOKIE_SECURE=false
WOOBE_REFRESH_COOKIE_SAME_SITE=lax
WOOBE_CSRF_COOKIE_NAME=woobe_csrf
WOOBE_CSRF_HEADER_NAME=x-csrf-token
WOOBE_LOGIN_RATE_LIMIT_ATTEMPTS=10
WOOBE_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
WOOBE_API_KEY_RATE_LIMIT_REQUESTS=120
WOOBE_API_KEY_RATE_LIMIT_WINDOW_SECONDS=60
WOOBE_REQUEST_MAX_BYTES=1048576
WOOBE_READINESS_TIMEOUT_SECONDS=3.0
WOOBE_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081
WOOBE_TRUSTED_HOSTS=localhost,127.0.0.1
WOOBE_HOST=0.0.0.0
WOOBE_PORT=8000

# ============================================================
# WORKERS
# ============================================================
WOOBE_WORKER_INTERVAL=5.0
WOOBE_WORKER_HEALTH_FILE=/tmp/woobe/worker-health.json
WOOBE_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WOOBE_WORKER_HEALTH_MAX_AGE_SECONDS=45
WOOBE_NETWORK_WORKER_PREFETCH=4
WOOBE_NETWORK_WORKER_SLOTS=4
WOOBE_OUTBOX_BATCH_SIZE=50
WOOBE_INBOX_BATCH_SIZE=50
WOOBE_OUTBOX_LOCK_TIMEOUT_SECONDS=300
WOOBE_INBOX_LOCK_TIMEOUT_SECONDS=300
WOOBE_OUTBOX_MAX_RETRIES=3
WOOBE_RETRY_BASE_DELAY_SECONDS=1.0
WOOBE_RETRY_MAX_DELAY_SECONDS=300.0
WOOBE_RETRY_BACKOFF_MULTIPLIER=2.0

# ============================================================
# WEB / CHAT EMBED
# ============================================================
VITE_API_URL=http://localhost:8000
VITE_CHAT_EMBED_URL=http://localhost:8081
VITE_WOOBE_EDITION=core
WOOBE_WEB_PORT=8080
WOOBE_CHAT_EMBED_PORT=8081
