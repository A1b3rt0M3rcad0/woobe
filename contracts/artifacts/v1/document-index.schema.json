{
  "$id": "urn:woobe:artifacts:v1:document-index",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "coverage": {
      "enum": [
        "complete",
        "partial",
        "needs_ocr",
        "unsupported"
      ],
      "title": "Coverage",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "engine": {
      "title": "Engine",
      "type": "string"
    },
    "engine_version": {
      "title": "Engine Version",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "title": "Id",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "max_depth": {
      "maximum": 64,
      "minimum": 0,
      "title": "Max Depth",
      "type": "integer"
    },
    "node_count": {
      "maximum": 110001,
      "minimum": 1,
      "title": "Node Count",
      "type": "integer"
    },
    "processing_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Processing Fingerprint",
      "type": "string"
    },
    "read_only": {
      "const": true,
      "default": true,
      "title": "Read Only",
      "type": "boolean"
    },
    "recipe_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Recipe Fingerprint",
      "type": "string"
    },
    "representation_set_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "title": "Representation Set Id",
      "type": "string"
    },
    "revision_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "title": "Revision Id",
      "type": "string"
    },
    "root_node_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "title": "Root Node Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_block_count": {
      "maximum": 100000,
      "minimum": 0,
      "title": "Source Block Count",
      "type": "integer"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "status": {
      "const": "ready",
      "default": "ready",
      "title": "Status",
      "type": "string"
    },
    "tree_kind": {
      "enum": [
        "headings",
        "canonical",
        "pages",
        "blocks",
        "empty"
      ],
      "title": "Tree Kind",
      "type": "string"
    },
    "workspace_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "workspace_id",
    "artifact_id",
    "revision_id",
    "representation_set_id",
    "source_sha256",
    "recipe_fingerprint",
    "processing_fingerprint",
    "engine",
    "engine_version",
    "tree_kind",
    "coverage",
    "root_node_id",
    "node_count",
    "source_block_count",
    "max_depth",
    "manifest_sha256",
    "created_at"
  ],
  "title": "DocumentIndexView",
  "type": "object"
}
