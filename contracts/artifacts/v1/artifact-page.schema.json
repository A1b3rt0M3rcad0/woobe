{
  "$defs": {
    "ArtifactView": {
      "additionalProperties": false,
      "properties": {
        "deleted": {
          "default": false,
          "title": "Deleted",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "file",
            "directory"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/RevisionView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "revision_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision Id"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "workspace_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspace_id",
        "path",
        "kind",
        "version"
      ],
      "title": "ArtifactView",
      "type": "object"
    },
    "RevisionView": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_type": {
          "title": "Content Type",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "node_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Id"
        },
        "operation_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        },
        "origin": {
          "enum": [
            "upload",
            "application",
            "agent",
            "tool",
            "processing",
            "copy"
          ],
          "title": "Origin",
          "type": "string"
        },
        "producer_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producer Id"
        },
        "run_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source_representation_entry_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Representation Entry Id"
        },
        "source_representation_set_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Representation Set Id"
        }
      },
      "required": [
        "id",
        "artifact_id",
        "content_type",
        "size_bytes",
        "sha256",
        "origin"
      ],
      "title": "RevisionView",
      "type": "object"
    }
  },
  "$id": "urn:woobe:artifacts:v1:artifact-page",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "has_more": {
      "title": "Has More",
      "type": "boolean"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ArtifactView"
      },
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Cursor"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "truncated": {
      "default": false,
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "items",
    "has_more"
  ],
  "title": "ArtifactPage",
  "type": "object"
}
