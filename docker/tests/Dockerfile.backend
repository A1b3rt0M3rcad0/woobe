# syntax=docker/dockerfile:1.7

ARG PYTHON_VERSION=3.14
ARG UV_VERSION=0.11.21

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv
FROM python:${PYTHON_VERSION}-slim

COPY --from=uv /uv /uvx /usr/local/bin/
RUN apt-get update \
    && apt-get install -y --no-install-recommends libatomic1 \
    && rm -rf /var/lib/apt/lists/*

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH="/app/src:/app" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --all-groups --extra test --no-install-project

COPY src/ src/
COPY tests/ tests/
COPY migrations/ migrations/
COPY scripts/ scripts/
COPY alembic.ini pytest.ini ./

CMD ["/bin/sh", "-c", "set -eu; ruff check src tests migrations; pyright_status=0; pyright src migrations > /tmp/backend-pyright.log 2>&1 || pyright_status=$?; cat /tmp/backend-pyright.log; mkdir -p /artifacts; cp /tmp/backend-pyright.log /artifacts/backend-pyright.log; if [ \"$pyright_status\" -eq 1 ]; then echo 'Pyright repository-wide diagnostics are currently non-blocking; continuing with blocking backend validation.'; elif [ \"$pyright_status\" -ne 0 ]; then exit \"$pyright_status\"; fi; alembic upgrade head; alembic current; alembic check; alembic downgrade -1; alembic upgrade head; alembic check; python -m pytest -q --junitxml=/artifacts/backend-pytest.xml"]
