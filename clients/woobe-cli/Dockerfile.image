# Native binaries come from the validated release archives, never a rebuild.
FROM alpine:3.21@sha256:ce64758a109eb420d874a118f87920e625e12d3634e03b4a5573fd9f6e5d3507 AS certificates
FROM scratch
ARG TARGETARCH
ARG CLI_VERSION
ARG CLI_COMMIT
ARG CLI_SOURCE
ARG CLI_MANIFEST_SHA256
COPY --from=certificates /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --chmod=0755 dist/oci/${TARGETARCH}/woobe /usr/local/bin/woobe
COPY --chown=10001:10001 --chmod=0700 dist/oci/data/ /data/
ENV HOME=/data XDG_CONFIG_HOME=/data
USER 10001:10001
WORKDIR /data
ENTRYPOINT ["/usr/local/bin/woobe"]
LABEL org.opencontainers.image.title="Woobe CLI" \
      org.opencontainers.image.description="Native Woobe CLI; Linux amd64 and arm64" \
      org.opencontainers.image.source=${CLI_SOURCE} \
      org.opencontainers.image.version=${CLI_VERSION} \
      org.opencontainers.image.revision=${CLI_COMMIT} \
      io.woobe.artifacts.sha256=${CLI_MANIFEST_SHA256}
